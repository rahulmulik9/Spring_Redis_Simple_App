{
  "info": {
    "name": "Redis Mini Shop",
    "description": "Redis Mini Shop - requests grouped by phase. Phase 1: plain Spring Boot + Postgres.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "productId", "value": "1" }
  ],
  "item": [
    {
      "name": "Phase 1 - Basic",
      "item": [
        {
          "name": "1.3 Get product (slow, ~2s)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "1.3 Update product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse Pro\",\n  \"price\": 999.00,\n  \"stock\": 45\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "1.3 Delete product 20",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/20",
              "host": ["{{baseUrl}}"],
              "path": ["products", "20"]
            }
          }
        },
        {
          "name": "1.3 Get missing product (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/99999",
              "host": ["{{baseUrl}}"],
              "path": ["products", "99999"]
            }
          }
        }
      ]
    }
  ]
}
