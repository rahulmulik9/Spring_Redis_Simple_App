{
  "info": {
    "name": "Redis Mini Shop",
    "description": "All endpoints across ShopController, CartController, CouponController, RecentlyViewedController, WishlistController",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "userId", "value": "101", "type": "string" }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"],
              "query": [
                { "key": "userId", "value": "{{userId}}", "description": "optional — triggers view tracking, recently-viewed, and score increment" }
              ]
            }
          }
        },
        {
          "name": "Get product by id (no userId, no view tracking)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Get all products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Product\",\n  \"price\": 499.0,\n  \"stock\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Add view (increment view count)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/view",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "view"]
            }
          }
        },
        {
          "name": "Get top products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/top?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products", "top"],
              "query": [
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Buy (SQL conditional UPDATE)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/buy",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "buy"]
            }
          }
        },
        {
          "name": "Buy (Redis DECR / Lua)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/buy-redis",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "buy-redis"]
            }
          }
        },
        {
          "name": "Checkout (broken TTL demo — 10.2)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/checkout-broken-ttl",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "checkout-broken-ttl"]
            }
          }
        },
        {
          "name": "Checkout (Redisson RLock — 10.3)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/checkout-redisson",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "checkout-redisson"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/add?userId={{userId}}&productId={{productId}}&qty=1",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "add"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" },
                { "key": "qty", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "Decrease in cart",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/decrease?userId={{userId}}&productId={{productId}}&qty=1",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "decrease"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" },
                { "key": "qty", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Remove from cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/remove?userId={{userId}}&productId={{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "remove"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Coupon",
      "item": [
        {
          "name": "Claim coupon",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coupon/claim?code=WELCOME10&userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["coupon", "claim"],
              "query": [
                { "key": "code", "value": "WELCOME10" },
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Recently Viewed",
      "item": [
        {
          "name": "Get recently viewed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recently-viewed?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recently-viewed"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Wishlist",
      "item": [
        {
          "name": "Add to wishlist",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/add?userId={{userId}}&productId={{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "add"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" }
              ]
            }
          }
        },
        {
          "name": "Get wishlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "Remove from wishlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/remove?userId={{userId}}&productId={{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "remove"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}