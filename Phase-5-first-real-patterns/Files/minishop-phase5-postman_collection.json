{
  "info": {
    "name": "Redis Mini Shop",
    "description": "Redis Mini Shop - matches ShopController, CartController, WishlistController, RecentlyViewedController as of Phase 5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "productId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "qty", "value": "1" }
  ],
  "item": [
    {
      "name": "Products (ShopController)",
      "item": [
        {
          "name": "Get all products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get product (no userId - no tracking)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Get product (with userId - view + recent + score)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse Pro\",\n  \"price\": 999.00,\n  \"stock\": 45\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Delete product 20",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/20",
              "host": ["{{baseUrl}}"],
              "path": ["products", "20"]
            }
          }
        },
        {
          "name": "Get missing product (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/99999",
              "host": ["{{baseUrl}}"],
              "path": ["products", "99999"]
            }
          }
        },
        {
          "name": "Add view (direct counter endpoint)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/view",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "view"]
            }
          }
        },
        {
          "name": "Get top products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/top?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products", "top"],
              "query": [
                { "key": "limit", "value": "5" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cart (CartController)",
      "item": [
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/add?userId={{userId}}&productId={{productId}}&qty={{qty}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "add"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" },
                { "key": "qty", "value": "{{qty}}" }
              ]
            }
          }
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "Decrease in cart",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/decrease?userId={{userId}}&productId={{productId}}&qty={{qty}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "decrease"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" },
                { "key": "qty", "value": "{{qty}}" }
              ]
            }
          }
        },
        {
          "name": "Remove item from cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/remove?userId={{userId}}&productId={{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "remove"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Wishlist (WishlistController)",
      "item": [
        {
          "name": "Add to wishlist",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/add?userId={{userId}}&productId={{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "add"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" }
              ]
            }
          }
        },
        {
          "name": "Get wishlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "Remove from wishlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/remove?userId={{userId}}&productId={{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "remove"],
              "query": [
                { "key": "userId", "value": "{{userId}}" },
                { "key": "productId", "value": "{{productId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Coupon (CouponController)",
      "item": [
        {
          "name": "Claim coupon",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coupon/claim?code=SAVE10&userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["coupon", "claim"],
              "query": [
                { "key": "code", "value": "SAVE10" },
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "Claim coupon - different code",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coupon/claim?code=WELCOME20&userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["coupon", "claim"],
              "query": [
                { "key": "code", "value": "WELCOME20" },
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Recently Viewed (RecentlyViewedController)",
      "item": [
        {
          "name": "Get recently viewed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recently-viewed?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recently-viewed"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}